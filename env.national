# Copy to sdp-upt-api/.env for national (shared_database / sdp_pusat)
# cp sdp-upt-api/env.national sdp-upt-api/.env

CI_ENVIRONMENT = development

app.baseURL = 'http://127.0.0.1:8081/'
app.indexPage =
app.forceGlobalSecureRequests = false

database.default.hostname = 127.0.0.1
database.default.port = 3307
database.default.database = sdp_pusat
database.default.username = sdp
database.default.password = sdp_local
database.default.DBDriver = MySQLi
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

tenancy.mode = shared_database

legacy.baseURL = 'http://127.0.0.1:9080'
frontend.origin = 'http://127.0.0.1:8082'

# Set jwt.secret and encryption.key from your working .env
